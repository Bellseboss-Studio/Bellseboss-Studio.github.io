---
import { team } from '../data/team';
---

<section id="team" class="section team">
  <div class="container">
    <div class="team__header reveal">
      <p class="section__label">// Crew</p>
      <h2 class="section__title">The Players</h2>
      <p class="section__subtitle">
        No NPCs here. Just a crew of passionate devs building worlds together.
      </p>
    </div>

    <div class="team__grid">
      {team.map((member, index) => (
        <article class="team-card reveal" style={`animation-delay: ${index * 0.08}s`}>
          <div class="team-card__inner">
            <div class="team-card__avatar">
              <div class="team-card__avatar-frame" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none">
                  <path d="M60 4L110 30V90L60 116L10 90V30L60 4Z" stroke="currentColor" stroke-width="2" opacity="0.3"/>
                  <path d="M60 8L106 32V88L60 112L14 88V32L60 8Z" stroke="currentColor" stroke-width="1" opacity="0.15"/>
                </svg>
              </div>
              <img
                src={member.image}
                alt={member.name}
                class="team-card__image"
                loading="lazy"
                width="140"
                height="140"
              />
              <div class="team-card__level" aria-hidden="true">
                <span>LVL</span>
                <strong>{20 + index * 3}</strong>
              </div>
            </div>
            <div class="team-card__info">
              <h3 class="team-card__name">{member.name}</h3>
              <p class="team-card__role">{member.role}</p>
              <p class="team-card__bio">{member.bio}</p>
            </div>
            {member.socials && (member.socials.itch || member.socials.github || member.socials.linkedin) && (
              <div class="team-card__links">
                {member.socials.itch && (
                  <a href={member.socials.itch} target="_blank" rel="noopener noreferrer" class="team-card__link" aria-label="itch.io">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M3.13 2.653C4.765 1.4 7.746 0 12.002 0c4.256 0 7.237 1.4 8.872 2.653 1.455 1.065 2.127 2.483 2.13 3.873v.004l.002.026c0 2.285-1.635 4.232-3.93 4.743a4.89 4.89 0 01-1.41.206c-1.27 0-2.45-.5-3.33-1.32-.88.82-2.06 1.32-3.33 1.32-.49 0-.96-.07-1.41-.206-2.295-.51-3.93-2.458-3.93-4.743v-.3c.003-1.39.675-2.808 2.13-3.873zM7.5 7.5c-.825 0-1.5.675-1.5 1.5s.675 1.5 1.5 1.5 1.5-.675 1.5-1.5-.675-1.5-1.5-1.5zm9 0c-.825 0-1.5.675-1.5 1.5s.675 1.5 1.5 1.5 1.5-.675 1.5-1.5-.675-1.5-1.5-1.5z"/>
                    </svg>
                  </a>
                )}
                {member.socials.github && (
                  <a href={member.socials.github} target="_blank" rel="noopener noreferrer" class="team-card__link" aria-label="GitHub">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  </a>
                )}
                {member.socials.linkedin && (
                  <a href={member.socials.linkedin} target="_blank" rel="noopener noreferrer" class="team-card__link" aria-label="LinkedIn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                    </svg>
                  </a>
                )}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team__header {
    margin-bottom: 4rem;
  }

  .team__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .team-card {
    position: relative;
    border-radius: 12px;
    transition: all var(--transition-slow);
  }

  .team-card__inner {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2rem 1.5rem;
    text-align: center;
    transition: all var(--transition-slow);
    position: relative;
    overflow: hidden;
  }

  .team-card__inner::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-neon-purple-glow), transparent 60%);
    opacity: 0;
    transition: opacity var(--transition-slow);
  }

  .team-card:hover .team-card__inner {
    border-color: rgba(168, 85, 247, 0.4);
    transform: translateY(-6px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4), 0 0 30px var(--color-neon-purple-glow);
  }

  .team-card:hover .team-card__inner::before {
    opacity: 1;
  }

  .team-card__avatar {
    position: relative;
    width: 110px;
    height: 110px;
    margin: 0 auto 1.2rem;
  }

  .team-card__avatar-frame {
    position: absolute;
    inset: -8px;
    color: var(--color-neon-purple);
    transition: all var(--transition-slow);
    opacity: 0;
  }

  .team-card:hover .team-card__avatar-frame {
    opacity: 1;
    animation: glitch-skew 0.3s ease-in-out;
  }

  .team-card__image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-border);
    transition: all var(--transition-slow);
    position: relative;
    z-index: 1;
  }

  .team-card:hover .team-card__image {
    border-color: var(--color-neon-purple);
    box-shadow: 0 0 20px var(--color-neon-purple-glow);
  }

  .team-card__level {
    position: absolute;
    bottom: -4px;
    right: -4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.25rem 0.45rem;
    background: var(--color-bg);
    border: 1px solid var(--color-neon-purple);
    border-radius: 6px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-text-muted);
    line-height: 1;
  }

  .team-card__level strong {
    font-size: 0.75rem;
    color: var(--color-neon-purple);
  }

  .team-card__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
    position: relative;
    z-index: 1;
  }

  .team-card__role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-neon-cyan);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.8rem;
    position: relative;
    z-index: 1;
  }

  .team-card__bio {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .team-card__links {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    position: relative;
    z-index: 1;
  }

  .team-card__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition: all var(--transition-base);
  }

  .team-card__link:hover {
    background: var(--color-neon-purple);
    border-color: var(--color-neon-purple);
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--color-neon-purple-glow);
  }
</style>
