---
import { studio } from '../data/studio';
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner container">
    <a href="#top" class="nav__logo">
      <span class="nav__logo-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <rect x="2" y="2" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
          <rect x="16" y="2" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
          <rect x="2" y="16" width="10" height="10" rx="2" stroke="currentColor" stroke-width="2"/>
          <rect x="16" y="16" width="10" height="10" rx="2" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2"/>
        </svg>
      </span>
      <span class="nav__logo-text">{studio.name}</span>
    </a>
    <ul class="nav__links" role="list">
      <li><a href="#games" class="nav__link">Games</a></li>
      <li><a href="#team" class="nav__link">Team</a></li>
      <li><a href="#services" class="nav__link">Services</a></li>
      <li><a href="#contact" class="nav__link">Contact</a></li>
    </ul>
    <a href="#contact" class="nav__cta btn btn--primary">
      <span>Start Project</span>
    </a>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(8, 8, 14, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid transparent;
    transition: all var(--transition-base);
  }

  .nav:hover {
    border-bottom-color: rgba(168, 85, 247, 0.15);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .nav__logo-icon {
    display: flex;
    color: var(--color-neon-purple);
    transition: color var(--transition-base);
  }

  .nav__logo:hover .nav__logo-icon {
    color: var(--color-neon-pink);
  }

  .nav__links {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }

  .nav__link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text-muted);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    transition: all var(--transition-base);
    position: relative;
  }

  .nav__link:hover {
    color: var(--color-text);
    background: rgba(168, 85, 247, 0.08);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-neon-purple);
    transition: all var(--transition-base);
    transform: translateX(-50%);
  }

  .nav__link:hover::after {
    width: 60%;
  }

  .nav__cta {
    padding: 0.6rem 1.4rem;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .nav__links {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .nav__cta {
      display: none;
    }
  }
</style>
