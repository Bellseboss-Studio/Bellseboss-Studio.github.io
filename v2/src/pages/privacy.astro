---
import Layout from '../layouts/Layout.astro';
import { studio } from '../data/studio';
---

<Layout title={`${studio.name} — Privacy Policy`}>
  <div class="legal-page">
    <div class="container">
      <div class="legal__content reveal">
        <h1 class="legal__title">Privacy Policy</h1>
        <p class="legal__updated">Last updated: August 2024</p>

        <h2>1. Information We Collect</h2>
        <p>
          {studio.name} ("we", "us", or "our") operates this website. We respect
          your privacy and are committed to protecting any personal data we
          collect.
        </p>

        <h2>2. Data Collection</h2>
        <p>We may collect:</p>
        <ul>
          <li>Personal information you provide through contact forms</li>
          <li>Usage data collected automatically</li>
          <li>Cookies for site functionality</li>
        </ul>

        <h2>3. How We Use Your Information</h2>
        <p>We use collected information to respond to inquiries, improve our services, and analyze usage patterns.</p>

        <h2>4. Third-Party Services</h2>
        <p>We may use third-party services that collect data under their own privacy policies.</p>

        <h2>5. Contact Us</h2>
        <p>
          Questions? Contact us at{' '}
          <a href={`mailto:${studio.contact.email}`}>{studio.contact.email}</a>.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .legal-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
  }

  .legal__content {
    max-width: 680px;
    margin: 0 auto;
  }

  .legal__title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .legal__updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .legal__content h2 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2rem 0 0.8rem;
    color: var(--color-neon-cyan);
  }

  .legal__content p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .legal__content ul {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .legal__content li {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.4rem;
  }

  .legal__content a {
    color: var(--color-neon-purple);
  }

  .legal__content a:hover {
    text-decoration: underline;
  }
</style>
